# === Canvas Flow — Environment Variables ===
# Copy this file to .env and fill in the values

# Your Canvas LMS URL (e.g. https://university.instructure.com)
CANVAS_BASE_URL=https://YOUR_SCHOOL.instructure.com

# Canvas Personal Access Token (get from Canvas → Settings → New Access Token)
CANVAS_TOKEN=your_canvas_token_here

# A random secret key to protect your API (generate with: openssl rand -hex 32)
API_SECRET=change_me_to_a_random_string

# Port for the backend server
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development
